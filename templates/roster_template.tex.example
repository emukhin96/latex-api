\documentclass[11pt]{article}

\parindent=0cm
\usepackage[12pt]{moresize}
\usepackage[main=russian]{babel}
\usepackage{fontspec}
\defaultfontfeatures{Ligatures={TeX},Renderer=Basic}

% Настройка шрифтов - ПРЯМЫЕ пути к файлам на сервере API
% ОБНОВИТЕ ПУТИ ПОСЛЕ КОПИРОВАНИЯ ШАБЛОНА!
% CMU (Computer Modern Unicode) для основного текста
\setmainfont{cmun}[
  Path=/opt/latex-api/fonts/CMU/,
  Extension=.ttf,
  UprightFont=*rm,
  BoldFont=*bx,
  ItalicFont=*ti,
  BoldItalicFont=*bi
]

\setsansfont{cmun}[
  Path=/opt/latex-api/fonts/CMU/,
  Extension=.ttf,
  UprightFont=*ss,
  BoldFont=*sx
]

\setmonofont{cmun}[
  Path=/opt/latex-api/fonts/CMU/,
  Extension=.ttf,
  UprightFont=*tt,
  BoldFont=*tb,
  ItalicFont=*ti
]

% Alias для текста документа
\newfontfamily\cmserif{cmun}[
  Path=/opt/latex-api/fonts/CMU/,
  Extension=.ttf,
  UprightFont=*rm,
  BoldFont=*bx,
  ItalicFont=*ti
]

% Circe для заголовков
\newfontfamily\circe{Circe}[
  Path=/opt/latex-api/fonts/Сirce/,
  Extension=.ttf,
  UprightFont=*-Regular,
  BoldFont=*-Bold
]
\usepackage{pifont}
