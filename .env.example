# latex-api — скопировать в .env на сервере (scripts/deploy.sh создаст его сам с ключами).
# Файл .env в git не попадает. Комментарии — только отдельными строками.

# Домен, по которому Caddy стека chemolymp отдаёт сервис (A-запись → IP демо-сервера).
LATEX_DOMAIN=latex.emukhin.ru

# Ключи по проектам: имя:ключ через запятую. Имя попадает в логи и в лимиты; ключ каждого
# проекта можно менять независимо. Сгенерировать:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Для chgkmsu подставьте ключ со старого сервера (API_KEY в /opt/latex-api/config.py), чтобы
# не трогать секреты на chgkmsu.ru.
LATEX_API_KEYS=chemolymp:CHANGE_ME,egormath:CHANGE_ME,chgkmsu:CHANGE_ME

# Порт на localhost сервера для curl-проверок (наружу не публикуется)
LATEX_API_PORT=8100

# Секунд на один проход движка
LATEX_COMPILE_TIMEOUT=90
# Одновременных компиляций (демо-сервер: 2 vCPU)
LATEX_MAX_CONCURRENT=2
# Сколько секунд ждать свободный слот, прежде чем ответить 503
LATEX_QUEUE_WAIT=30
# Запросов в минуту на клиента; 0 = выключено (нагрузку сдерживает семафор выше)
LATEX_RATE_LIMIT_PER_MINUTE=0
LATEX_DEFAULT_ENGINE=xelatex
# Старые эндпоинты (compile-latex): движок и число прогонов, как на прежнем сервере после патча egormath
LATEX_LEGACY_ENGINE=xelatex
LATEX_LEGACY_PASSES=2

LOG_LEVEL=INFO

# База образа: полная схема TeX Live (~5 ГБ на диске). Альтернатива — texlive/texlive:latest-medium.
TEXLIVE_IMAGE=texlive/texlive:latest
